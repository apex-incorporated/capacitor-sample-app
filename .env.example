# Apex project key — use a sandbox project's key (prefix `sbx-`) from
# /dashboard/settings → Snippet. Sandbox is the isolation primitive for
# the sample app: events are excluded from production billing,
# dashboards, and CRM stitching, with no separate `testMode` flag
# required.
VITE_APEX_PROJECT_KEY=your-project-key-here

# API base URL. Local dashboard: http://localhost:3000.
# Production: https://app.apex.inc
VITE_APEX_API_URL=http://localhost:3000

# Optional — set this to your laptop's LAN IP when running a real device
# against a local Vite dev server. Used by capacitor.config.ts.
# APEX_DEV_URL=http://192.168.1.12:5173
