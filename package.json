{
  "name": "apex-capacitor-sample-app",
  "version": "0.1.0",
  "private": true,
  "description": "Reference Capacitor + React app that exercises every @apex-inc/capacitor-plugin API. Use it as a starting point or as a living integration test.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ios:add": "npx cap add ios && npm run icons:ios",
    "android:add": "npx cap add android",
    "ios:sync": "npm run build && npx cap sync ios && npm run icons:ios",
    "android:sync": "npm run build && npx cap sync android",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "android:open": "npm run android:sync && npx cap open android",
    "seed": "npx tsx scripts/seed-apex-outfitters-demo.ts",
    "icons:ios": "node scripts/generate-ios-app-icon.mjs"
  },
  "dependencies": {
    "@apex-inc/capacitor-plugin": "^2.1.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/status-bar": "^6.0.3",
    "@types/qrcode": "^1.5.6",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/apex-incorporated/capacitor-sample-app"
  },
  "homepage": "https://github.com/apex-incorporated/capacitor-sample-app",
  "engines": {
    "node": ">=18"
  }
}
